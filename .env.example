# For local development these are optional. Docker generates a persistent encryption key.
PORT=3001
APP_ORIGIN=http://localhost:3001
# ENCRYPTION_KEY=64_hex_characters
# DATABASE_URL=postgres://flowline:flowline@localhost:5432/flowline
# REDIS_URL=redis://localhost:6379
# Netlify Functions require ENCRYPTION_KEY and RUNNER_SECRET, configured in the Netlify dashboard.
# Optional Supabase PostgreSQL + Google OAuth (server variables only):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# GOOGLE_AUTH_ENABLED=true
# DATABASE_SCOPE=development
